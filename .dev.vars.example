# Local Worker variables for `npm run dev` / `npm run preview` (copy to .dev.vars, git-ignored).
# These mirror `vars` and the secrets of a deployed Worker. On Cloudflare the AWS_* values
# are secrets (`wrangler secret put`), never entries in wrangler.jsonc.

# Rehearse the send dialog without AWS:
# STUDIO_SEND_ENABLED=true
# STUDIO_SEND_DRY_RUN=true
# AWS_REGION=us-east-1
# SES_FROM_ADDRESS=studio@example.test
# SES_ALLOWED_RECIPIENTS=you@example.test
# Or "*" for any address typed in the studio (see the caveat below):
# SES_ALLOWED_RECIPIENTS=*

# Send for real from the local Worker (workerd). Same code path as production.
# STUDIO_SEND_ENABLED=true
# STUDIO_SEND_DRY_RUN=false
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# SES_FROM_ADDRESS=verified-sender@example.com
# SES_ALLOWED_RECIPIENTS=you@example.com
# "*" accepts any valid address instead of a list. Only with production access and
# the SES suppression list on: a typo then reaches a real stranger, for real.
# SES_ALLOWED_RECIPIENTS=*
# SES_CONFIGURATION_SET=

# Who the API runs as locally. Without this (or ACCESS_* below) every /api/* call is 401.
# STUDIO_DEV_IDENTITY=you@swarm.work

# Production only: verify a real Cloudflare Access JWT instead of trusting the line above.
# Both are required together; setting only one refuses all requests on purpose.
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=<Application Audience (AUD) tag from the Access application>

# Shared password gate, when Cloudflare Access is not set up yet. Minimum 12 characters.
# Generate one with: openssl rand -base64 24
# STUDIO_PASSWORD=
