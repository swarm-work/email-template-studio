# Local send server configuration. Copy to .env (git-ignored) and adjust.
#
# Credentials ARE set here now. The studio signs its own SES requests (aws4fetch)
# so that the same code runs in Node and in the Cloudflare Worker, and a Worker
# cannot read ~/.aws. If you keep your keys in an AWS profile, export them:
#   aws configure export-credentials --profile default --format env

# Master switch. Anything other than "true" keeps the server in disabled mode.
STUDIO_SEND_ENABLED=true
# true = exercise the whole path but never call SES (returns dry-run-N message ids).
# Fail-safe default: set to false only when you are ready to send for real.
# While this is true, the AWS_* keys below are not needed at all.
STUDIO_SEND_DRY_RUN=true

# The region that holds your SES identities (identities are per region).
AWS_REGION=us-east-1

# Required once STUDIO_SEND_DRY_RUN is false. Never commit real values.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# Only for temporary (STS / SSO) credentials:
# AWS_SESSION_TOKEN=...

# A verified SES identity to send from, and who tests may go to.
SES_FROM_ADDRESS=verified-sender@example.com
SES_ALLOWED_RECIPIENTS=you@example.com,teammate@example.com
# Or open it up to any address typed in the studio. Only do this with a verified
# domain, production access and the SES suppression list on: typos then reach
# real strangers. The 10-per-send cap, the [TEST] prefix and the rate limit still apply.
# SES_ALLOWED_RECIPIENTS=*
# SES_CONFIGURATION_SET=

STUDIO_SERVER_PORT=8787
STUDIO_SEND_RATE_LIMIT_PER_MINUTE=5

# Who the Node send server runs as. Defaults to developer@localhost when unset;
# the server binds to 127.0.0.1, so this names the caller rather than gating them.
# STUDIO_DEV_IDENTITY=you@swarm.work

# Feature flags, mirrored from wrangler.jsonc. Only the literal "false" switches
# the visual editor off; anything else (including unset) leaves it on.
# STUDIO_VISUAL_EDITOR=false

# Where the studio keeps templates. Unset (or "http") is the real API, which
# needs the local D1 database: run `npm run db:migrate` once before `npm run dev`.
# "memory" is the escape hatch for running with no database: the starters are
# there, everything you save is gone on reload, and nothing is written to disk.
# VITE_DATA_MODE=memory
