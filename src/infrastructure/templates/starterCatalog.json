  {
    "slug": "welcome-verification",
    "name": "Welcome & verification",
    "description": "Sent after sign-up. Asks the user to confirm their email address before the account is activated.",
    "category": "onboarding",
    "status": "ready",
    "tags": ["sign-up", "verification"],
    "version": {
      "number": 3,
      "label": "v3",
      "createdAt": "2026-08-21T09:30:00Z"
    },
    "createdAt": "2026-08-21T09:30:00Z",
    "sourceFile": "welcome-verification.email.tsx",
    "envelope": {
      "subject": "Verify your email address",
      "preheader": "",
      "replyTo": ""
    },
    "samplePayload": {
      "recipientName": "Ada",
      "verificationUrl": "https://app.meridian.example/verify?token=sample-token",
      "expiresInHours": 24,
      "productName": "Meridian",
      "supportEmail": "support@meridian.example"
    },
    "propsSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "recipientName": {
          "type": "string",
          "minLength": 1
        },
        "verificationUrl": {
          "type": "string",
          "format": "uri"
        },
        "expiresInHours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "productName": {
          "type": "string",
          "minLength": 1
        },
        "supportEmail": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": ["recipientName", "verificationUrl", "expiresInHours", "productName", "supportEmail"],
      "additionalProperties": false
    }
  },
