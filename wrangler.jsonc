/**
 * Cloudflare Worker configuration. One Worker serves the built studio as static
 * assets and runs the Hono API for /api/*. See docs/DEPLOYMENT.md.
 *
 * Since 2026-09-28 the deploy targets are the three NAMED environments below
 * (`env.dev`, `env.staging`, `env.production`), each its own Worker script with
 * its own D1 database: `npm run deploy:<env>`. `env.production` is production
 * (email-template-studio-production.swarm-work-emailer.workers.dev).
 *
 * The TOP-LEVEL block is the legacy Worker `email-template-studio`. It is frozen
 * on its 2026-09-18 build (password gate, live SES sending to one allow-listed
 * address, no D1 tables) and is not deployed to any more; retiring it is
 * docs/PRIORITIES.md item 3.3. Its block stays because `wrangler types`
 * derives `Env` from it and because `.dev.vars` + `npm run dev` run against it
 * locally. `env.e2e` is only used by the Playwright suite.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Named explicitly because this login can see several accounts; without it
  // wrangler has to ask which one to deploy to.
  "account_id": "d0fa6b3d72170539438800a907ec5323",
  "name": "email-template-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Everything except /api/* and /media/* is answered from the built files;
    // unknown paths get index.html. /media/* is the R2-backed image store the
    // visual editor uploads to, so the Worker has to see it before the asset
    // layer. Vite builds the studio's own JS, CSS and fonts into /assets/, which
    // is why uploads do NOT live there: a static file never costs a Worker
    // invocation (see server/uploadRoutes.ts).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  // Templates and their versions live in D1 (SQLite). One-time setup:
  //   npx wrangler d1 create email-template-studio
  // and paste the id it prints over the placeholder below. See docs/DEPLOYMENT.md.
  // `preview_database_id` is deliberately absent: local dev, `vite preview` and
  // `wrangler d1 ... --local` then all share one SQLite file under .wrangler/state/v3.
  "d1_databases": [
    {
      "binding": "STUDIO_DB",
      "database_name": "email-template-studio",
      // The real production database, created 2026-09-22 on swarm-work-emailer.
      // Not a secret: a database id names a resource, and reaching it still needs
      // an authenticated API token or this Worker's binding.
      //
      // It is EMPTY until `npm run db:migrate:prod` has been run against it once.
      // A deploy without that leaves every template route answering
      // "no such table: templates" rather than the 503 an absent binding gives,
      // which is the more confusing of the two failures.
      "database_id": "f270cbc3-4b5e-457b-af43-ea3130904e2b",
      "migrations_dir": "migrations",
    },
  ],
  // Images pasted or uploaded into a visual template. One-time setup:
  //   npx wrangler r2 bucket create email-template-studio-assets
  "r2_buckets": [
    {
      "binding": "STUDIO_ASSETS",
      "bucket_name": "email-template-studio-assets",
    },
  ],
  "observability": { "enabled": true },
  "vars": {
    // Live Amazon SES sending, on this account, deliberately (docs/DEPLOYMENT.md).
    //
    // SES_ALLOWED_RECIPIENTS takes one of two forms:
    //   "a@x.io,b@y.io"  only those addresses may receive (today's value)
    //   "*"              anyone signed in may type any valid address
    // Either way the other guards still apply: at most 10 recipients per send,
    // the forced [TEST] subject prefix, and 5 sends per minute. The IAM policy
    // on the AWS key (infra/ses-policy.json) and the SES account suppression
    // list are the real backstops; rolling back is this one value plus a deploy.
    //
    // The AWS keys live on swarm-work-emailer, the account this repo deploys to.
    // docs/HANDOVER.md's "this account must hold no AWS credentials" was written
    // about a personal account and does not apply here. Sending is deliberately
    // narrow all the same: a test sender (testing@swarm.camp) behind the shared
    // password gate, to SES_ALLOWED_RECIPIENTS only. Revisit the blast radius
    // before anyone outside the team can reach the studio.
    //
    // THREE SECRETS ARE REQUIRED before deploying with this on. They never belong
    // in this file, and without them the Worker answers 500 on every /api/* route:
    //   npx wrangler secret put STUDIO_PASSWORD        (the shared password gate)
    //   npx wrangler secret put AWS_ACCESS_KEY_ID
    //   npx wrangler secret put AWS_SECRET_ACCESS_KEY
    //
    // Use long-lived IAM user keys, not SSO/STS ones: temporary credentials expire
    // within the hour and the Worker cannot refresh them, so sending would simply
    // stop. See "Turning live sending on" in docs/DEPLOYMENT.md.
    "STUDIO_SEND_ENABLED": "true",
    "STUDIO_SEND_DRY_RUN": "false",
    // The rollback switch for the visual editor (docs/DEPLOYMENT.md). Set it to
    // the literal "false" in the matching env block and run `npm run deploy:<env>`
    // - a plain `wrangler deploy` now follows whichever environment's build
    // config ran last, so it is not a safe substitute - and every visual
    // template opens read-only in Preview mode. Anything else, including
    // absent, is "on".
    "STUDIO_VISUAL_EDITOR": "true",
    "AWS_REGION": "ap-southeast-2",
    "SES_FROM_ADDRESS": "testing@swarm.camp",
    "SES_ALLOWED_RECIPIENTS": "echo@swarm.work",
  },
  "env": {
    // The three deployed environment Workers. They are separate Worker scripts,
    // each with its own D1 database (created 2026-09-28; the ids below are real).
    //
    // `vars`, `d1_databases` and `r2_buckets` are NON-INHERITABLE keys: a named
    // environment that omits one gets NOTHING, not the top-level value. An
    // environment missing its `d1_databases` block still boots and still serves
    // the studio, and then answers 503 storage-unavailable on every template
    // route - which reads like a code bug rather than a configuration one. That
    // is why each block below repeats `vars` and `d1_databases` in full even
    // where the values are identical to the top level.
    //
    // `main`, `assets`, `compatibility_*` and `observability` ARE inherited, so
    // they are not repeated. The evidence is `env.e2e` below: it omits all four
    // and its Playwright suite drives the full studio UI, which is served from
    // the inherited `assets` block.
    //
    // NO `r2_buckets` on these three, deliberately (TECH_DEBT #48). R2 is not
    // enabled on the account, and a Worker that binds a bucket that does not
    // exist cannot be deployed at all - which is why nothing could be deployed
    // between 2026-09-19 (the binding arrived) and 2026-09-28. Without the
    // binding the Worker boots with `objectStore: null`: image upload in the
    // visual editor answers 503 and everything else works. When R2 is enabled:
    //   npx wrangler r2 bucket create email-template-studio-assets-<env>
    // then add `"r2_buckets": [{ "binding": "STUDIO_ASSETS", "bucket_name": "..." }]`
    // to each block and redeploy.
    //
    // STYTCH_PROJECT_ID is a plain var, not a secret: it is public and appears
    // in the JWKS URL (docs/STYTCH_PLAN.md section 4). This is the TEST project
    // that sign-in was proven on; moving production to the Live project is a
    // later change. The browser half, VITE_STYTCH_PUBLIC_TOKEN, is baked in at
    // BUILD time from `.env.local` (locally) or a repository variable (CI). Each
    // Worker's hostname must also be an authorised domain and a redirect URL
    // (`https://<host>/authenticate`) in the Stytch project, or sign-in fails
    // with bad_domain_for_stytch_sdk.
    //
    // Send posture is deliberately conservative: none of these three sends live
    // mail yet. `production` goes live in a separate change that sets the AWS
    // key secrets on it and flips its two STUDIO_SEND_* vars (docs/DEPLOYMENT.md).
    //
    // `preview_database_id` is deliberately absent throughout, for the reason
    // given on the top-level block.
    "dev": {
      "name": "email-template-studio-dev",
      "vars": {
        "STUDIO_ENVIRONMENT": "dev",
        "STUDIO_SEND_ENABLED": "false",
        "STUDIO_SEND_DRY_RUN": "true",
        "STUDIO_VISUAL_EDITOR": "true",
        "AWS_REGION": "ap-southeast-2",
        "SES_FROM_ADDRESS": "testing@swarm.camp",
        "SES_ALLOWED_RECIPIENTS": "echo@swarm.work",
        "STYTCH_PROJECT_ID": "project-test-33c9013d-46a4-4fd3-bff3-cbeabe44ee87",
      },
      "d1_databases": [
        {
          "binding": "STUDIO_DB",
          "database_name": "email-template-studio-dev",
          "database_id": "ee106ea3-f1d4-49ef-b95f-6cd5021875de",
          "migrations_dir": "migrations",
        },
      ],
    },
    "staging": {
      "name": "email-template-studio-staging",
      "vars": {
        "STUDIO_ENVIRONMENT": "staging",
        "STUDIO_SEND_ENABLED": "true",
        "STUDIO_SEND_DRY_RUN": "true",
        "STUDIO_VISUAL_EDITOR": "true",
        "AWS_REGION": "ap-southeast-2",
        "SES_FROM_ADDRESS": "testing@swarm.camp",
        "SES_ALLOWED_RECIPIENTS": "echo@swarm.work",
        "STYTCH_PROJECT_ID": "project-test-33c9013d-46a4-4fd3-bff3-cbeabe44ee87",
      },
      "d1_databases": [
        {
          "binding": "STUDIO_DB",
          "database_name": "email-template-studio-staging",
          "database_id": "3a8403ac-6d9d-4704-81cc-211fd5d88465",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "email-template-studio-production",
      "vars": {
        "STUDIO_ENVIRONMENT": "production",
        // Dry-run first: flipping these two to true/false, together with the
        // AWS key secrets, is what makes this Worker send real mail.
        "STUDIO_SEND_ENABLED": "false",
        "STUDIO_SEND_DRY_RUN": "true",
        "STUDIO_VISUAL_EDITOR": "true",
        "AWS_REGION": "ap-southeast-2",
        "SES_FROM_ADDRESS": "testing@swarm.camp",
        "SES_ALLOWED_RECIPIENTS": "echo@swarm.work",
        "STYTCH_PROJECT_ID": "project-test-33c9013d-46a4-4fd3-bff3-cbeabe44ee87",
      },
      "d1_databases": [
        {
          "binding": "STUDIO_DB",
          "database_name": "email-template-studio-production",
          "database_id": "496ceadb-e389-4101-9e74-0408201c9a2a",
          "migrations_dir": "migrations",
        },
      ],
    },
    // Playwright: exercises the send dialog end to end without AWS (fake message ids).
    "e2e": {
      "vars": {
        "STUDIO_SEND_ENABLED": "true",
        "STUDIO_SEND_DRY_RUN": "true",
        "STUDIO_VISUAL_EDITOR": "true",
        "AWS_REGION": "us-east-1",
        "SES_FROM_ADDRESS": "studio@example.test",
        "SES_ALLOWED_RECIPIENTS": "qa@example.test,second@example.test",
        // No Access in front of the test build, so the API runs as this fixed identity.
        "STUDIO_DEV_IDENTITY": "playwright@example.test",
      },
      // Bindings are NOT inherited by a named environment, so both are repeated
      // here. A separate database id keeps the Playwright run from touching the
      // database `npm run dev` uses, even though both live in .wrangler/state/v3.
      "d1_databases": [
        {
          "binding": "STUDIO_DB",
          "database_name": "email-template-studio-e2e",
          "database_id": "00000000-0000-4000-8000-0000000000e2",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "STUDIO_ASSETS",
          "bucket_name": "email-template-studio-assets-e2e",
        },
      ],
    },
  },
}
